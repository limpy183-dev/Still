<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Still Setup" Width="640" Height="500" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" FontSize="13" Foreground="#252A27" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Background" Value="#293126"/>
      <Setter Property="Foreground" Value="#F6F9EE"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="20,11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}" BorderThickness="2" BorderBrush="Transparent">
              <StackPanel Orientation="Horizontal">
                <ContentPresenter VerticalAlignment="Center"/>
                <Path Data="M0,5 H11 M7,1 L11,5 L7,9" Stroke="#D7ED9D" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="10,1,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#3C4932"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#7C963F"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Secondary" TargetType="Button">
      <Setter Property="Foreground" Value="#7B8969"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" Background="White" BorderBrush="#E0E6D6" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#F0F5E7"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#7C963F"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WindowButton" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Foreground" Value="#767D72"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#E0E4D9"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Foreground" Value="#767D72"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="0,15,0,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#C64B4B"/><Setter Property="Foreground" Value="White"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="20,0,0,0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="36" Height="21" CornerRadius="11" Background="#D7DDD0" BorderThickness="2" BorderBrush="Transparent">
              <Ellipse x:Name="Thumb" Width="13" Height="13" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.18" Color="#4C5F28"/></Ellipse.Effect>
              </Ellipse>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#99B365"/>
                <Trigger.EnterActions>
                  <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="15" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#80944F"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Row" TargetType="Border">
      <Setter Property="BorderBrush" Value="#EDF0E6"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
      <Setter Property="Padding" Value="0,13"/>
    </Style>
    <Style x:Key="RowTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="RowText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="#8A957C"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Bar" TargetType="Border">
      <Setter Property="Width" Value="5"/>
      <Setter Property="CornerRadius" Value="2.5"/>
      <Setter Property="Background" Value="#252A27"/>
      <Setter Property="Margin" Value="0,0,3.5,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Border Margin="18" CornerRadius="16" Background="#F5F6F1" BorderBrush="#E1E5DA" BorderThickness="1">
    <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.16" Color="#1B2415"/></Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <Border x:Name="TitleBar" Background="#EEF0E9" CornerRadius="15,15,0,0">
        <DockPanel>
          <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource CloseButton}" Content="✕" FontSize="11" AutomationProperties.Name="Close"/>
          <Button x:Name="MinimizeButton" DockPanel.Dock="Right" Style="{StaticResource WindowButton}" Content="–" AutomationProperties.Name="Minimize"/>
          <TextBlock x:Name="TitleText" Margin="22,0,0,0" VerticalAlignment="Center" FontSize="9" FontWeight="ExtraBold" Foreground="#91978E" Text="STILL · SETUP"/>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1" Margin="36,24,36,24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Margin="0,2,9,0" VerticalAlignment="Center">
            <StackPanel.RenderTransform><RotateTransform Angle="-8" CenterX="10" CenterY="12"/></StackPanel.RenderTransform>
            <Border Style="{StaticResource Bar}" Height="13"/>
            <Border Style="{StaticResource Bar}" Height="21"/>
            <Border Style="{StaticResource Bar}" Height="17"/>
          </StackPanel>
          <TextBlock FontSize="27" FontWeight="ExtraBold" VerticalAlignment="Center"><Run Text="still"/><Run Text="." Foreground="#7F974F"/></TextBlock>
        </StackPanel>

        <Canvas x:Name="Orbit" Width="72" Height="56" HorizontalAlignment="Right" VerticalAlignment="Top" Grid.RowSpan="3" Margin="0,4,0,0">
          <Canvas.RenderTransform><RotateTransform x:Name="OrbitSpin" CenterX="36" CenterY="28"/></Canvas.RenderTransform>
          <Ellipse Width="56" Height="56" Stroke="#C9D2BC"/>
          <Ellipse Canvas.Left="16" Width="56" Height="56" Stroke="#C9D2BC"/>
          <Ellipse Canvas.Left="45" Canvas.Top="5" Width="7" Height="7" Fill="#A9BA86"/>
        </Canvas>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,24,0,0">
          <Ellipse Width="5" Height="5" Fill="#9EAF7F" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock x:Name="Eyebrow" FontSize="9.5" FontWeight="ExtraBold" Foreground="#919A84"/>
        </StackPanel>
        <TextBlock x:Name="Heading" Grid.Row="2" FontSize="31" FontWeight="SemiBold" Margin="0,6,0,6"/>
        <TextBlock x:Name="Body" Grid.Row="3" FontSize="13" Foreground="#7D8577" TextWrapping="Wrap" MaxWidth="500" HorizontalAlignment="Left" LineHeight="20"/>

        <Border x:Name="Card" Grid.Row="4" Margin="0,18,0,0" VerticalAlignment="Top" Background="White" CornerRadius="18" BorderBrush="#E9ECE4" BorderThickness="1" Padding="22,2">
          <StackPanel x:Name="Rows">
            <Border x:Name="RowVersion" Style="{StaticResource Row}">
              <DockPanel>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#5C752E"/>
                <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Version"/><TextBlock Style="{StaticResource RowText}" Text="Sessions, preferences, alerts and to-dos are kept."/></StackPanel>
              </DockPanel>
            </Border>
            <Border x:Name="RowLocation" Style="{StaticResource Row}">
              <StackPanel><TextBlock x:Name="LocationLabel" Style="{StaticResource RowTitle}" Text="Installs to"/><TextBlock x:Name="LocationText" Style="{StaticResource RowText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel>
            </Border>
            <Border x:Name="RowDesktop" Style="{StaticResource Row}">
              <DockPanel>
                <CheckBox x:Name="DesktopSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="True" AutomationProperties.Name="Desktop shortcut"/>
                <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Desktop shortcut"/><TextBlock Style="{StaticResource RowText}" Text="Keep Still one double-click away."/></StackPanel>
              </DockPanel>
            </Border>
            <Border x:Name="RowGuard" Style="{StaticResource Row}">
              <DockPanel>
                <CheckBox x:Name="GuardSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="True" AutomationProperties.Name="Remove Windows protection"/>
                <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Remove Windows protection"/><TextBlock Style="{StaticResource RowText}" Text="Needs administrator approval. Not possible during an active focus session."/></StackPanel>
              </DockPanel>
            </Border>
            <Border x:Name="RowData" Style="{StaticResource Row}">
              <DockPanel>
                <CheckBox x:Name="DataSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="Also remove my data"/>
                <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Also remove my data"/><TextBlock Style="{StaticResource RowText}" Text="Preferences, alerts, to-dos and session history on this PC."/></StackPanel>
              </DockPanel>
            </Border>
            <Border x:Name="RowLaunch" Style="{StaticResource Row}">
              <DockPanel>
                <CheckBox x:Name="LaunchSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="True" AutomationProperties.Name="Open Still now"/>
                <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Open Still now"/><TextBlock Style="{StaticResource RowText}" Text="You'll also find it in the Start menu as Still Focus."/></StackPanel>
              </DockPanel>
            </Border>
            <Border x:Name="RowProgress" Style="{StaticResource Row}" Padding="0,18">
              <StackPanel>
                <DockPanel>
                  <TextBlock x:Name="PercentText" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="#5C752E"/>
                  <TextBlock x:Name="StatusText" Style="{StaticResource RowTitle}"/>
                </DockPanel>
                <ProgressBar x:Name="Progress" Height="8" Margin="0,12,0,0" Maximum="100">
                  <ProgressBar.Template>
                    <ControlTemplate TargetType="ProgressBar">
                      <Grid>
                        <Border x:Name="PART_Track" CornerRadius="4" Background="#EDF0E6"/>
                        <Border x:Name="PART_Indicator" CornerRadius="4" HorizontalAlignment="Left">
                          <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#B5CC7E" Offset="0"/><GradientStop Color="#99B365" Offset="1"/></LinearGradientBrush></Border.Background>
                        </Border>
                      </Grid>
                    </ControlTemplate>
                  </ProgressBar.Template>
                </ProgressBar>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <DockPanel Grid.Row="5" LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="SecondaryButton" Style="{StaticResource Secondary}" Content="Cancel"/>
            <Button x:Name="PrimaryButton" Style="{StaticResource Primary}" IsDefault="True"/>
          </StackPanel>
          <TextBlock x:Name="Note" FontSize="11" Foreground="#95A183" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"/>
        </DockPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
