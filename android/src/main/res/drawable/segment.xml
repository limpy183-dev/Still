<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="200" android:exitFadeDuration="200">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/selected" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape>
            <solid android:color="@color/paper" />
            <stroke android:width="1dp" android:color="@color/line" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/line" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
