<?xml version="1.0" encoding="utf-8"?>
<!-- .page-heading: eyebrow, a two-tone title and a line of welcome. Filled in by Nav.attach. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp">

    <!-- The eyebrow, with Settings at the end of the row (the desktop sidebar's Settings). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/eyebrow"
            style="@style/Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableStart="@drawable/dot"
            android:drawablePadding="7dp"
            android:drawableTint="@color/ring"
            android:gravity="center_vertical" />

        <ImageButton
            android:id="@+id/settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="-10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings"
            android:tint="@color/muted"
            android:tooltipText="@string/settings" />
    </LinearLayout>

    <TextView
        android:id="@+id/heading"
        style="@style/Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:accessibilityHeading="true" />

    <TextView
        android:id="@+id/subtitle"
        style="@style/Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="14sp" />
</LinearLayout>
