<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <include layout="@layout/page_heading" />

            <Button
                android:id="@+id/history_export"
                style="@style/Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:drawableStart="@drawable/ic_download"
                android:drawablePadding="8dp"
                android:text="@string/history_export" />

            <!-- .stats-row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false">

                <LinearLayout
                    style="@style/Panel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:padding="14dp">

                    <TextView
                        style="@style/Hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/history_total"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/stat_total"
                        style="@style/Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="1"
                        android:textColor="@color/selected_ink"
                        android:textSize="22sp" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Panel"
                    android:layout_width="0dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:padding="14dp">

                    <TextView
                        style="@style/Hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/history_completed"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/stat_completed"
                        style="@style/Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="1"
                        android:textColor="@color/selected_ink"
                        android:textSize="22sp" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Panel"
                    android:layout_width="0dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:padding="14dp">

                    <TextView
                        style="@style/Hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/history_week"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/stat_week"
                        style="@style/Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="1"
                        android:textColor="@color/selected_ink"
                        android:textSize="22sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- .progress-panel -->
            <LinearLayout style="@style/Panel">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/history_wider" />
                </LinearLayout>

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/history_daily" />

                <RadioGroup
                    android:id="@+id/history_range"
                    style="@style/SegmentTrack"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/range_7"
                        style="@style/Segment"
                        android:text="@string/history_range_7" />

                    <RadioButton
                        android:id="@+id/range_30"
                        style="@style/Segment"
                        android:text="@string/history_range_30" />

                    <RadioButton
                        android:id="@+id/range_90"
                        style="@style/Segment"
                        android:text="@string/history_range_90" />
                </RadioGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/history_goal_label"
                        style="@style/Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:labelFor="@+id/history_goal"
                        android:text="@string/history_goal"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@id/history_goal"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="4"
                        android:minHeight="44dp"
                        android:paddingVertical="6dp"
                        android:selectAllOnFocus="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/history_summary"
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/soft_box"
                    android:lineSpacingExtra="4dp"
                    android:padding="14dp"
                    android:textSize="14sp" />

                <FrameLayout
                    android:id="@+id/history_chart"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginTop="18dp" />

                <TextView
                    android:id="@+id/history_scale"
                    style="@style/Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="12sp" />

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/history_intentions" />

                <TextView
                    android:id="@+id/history_intentions_total"
                    style="@style/Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:id="@+id/history_intentions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- .history-panel -->
            <LinearLayout style="@style/Panel">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/history_sessions_title" />

                    <TextView
                        style="@style/Tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/history_saved_tag" />
                </LinearLayout>

                <RadioGroup
                    android:id="@+id/history_filter"
                    style="@style/SegmentTrack"
                    android:layout_marginTop="14dp">

                    <RadioButton
                        android:id="@+id/filter_active"
                        style="@style/Segment"
                        android:text="@string/history_unarchived" />

                    <RadioButton
                        android:id="@+id/filter_archived"
                        style="@style/Segment"
                        android:text="@string/history_archived" />

                    <RadioButton
                        android:id="@+id/filter_all"
                        style="@style/Segment"
                        android:text="@string/history_all" />
                </RadioGroup>

                <TextView
                    style="@style/Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/history_archive_note"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/history_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/history_more"
                    style="@style/AddButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/history_more" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/nav_bar" />
</LinearLayout>
