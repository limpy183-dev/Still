<?xml version="1.0" encoding="utf-8"?>
<!-- The alert editor, with the fields of the Windows alert dialog (app/index.html #alert-dialog). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/alert_heading"
                style="@style/Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/alert_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/alert_title_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="120" />

            <EditText
                android:id="@+id/alert_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/alert_note_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="500" />

            <TextView
                style="@style/Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/alert_when" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/alert_date_label"
                    style="@style/Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/alert_date"
                    style="@style/Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/alert_time"
                    style="@style/Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAllCaps="false" />
            </LinearLayout>

            <RadioGroup
                android:id="@+id/alert_repeat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/repeat_once"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/repeat_once" />

                <RadioButton
                    android:id="@+id/repeat_daily"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/repeat_daily" />

                <RadioButton
                    android:id="@+id/repeat_weekdays"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/repeat_weekdays" />
            </RadioGroup>

            <RadioGroup
                android:id="@+id/alert_length"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/length_duration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/length_duration" />

                <RadioButton
                    android:id="@+id/length_range"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/length_range" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/alert_duration_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp">

                <TextView
                    style="@style/Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:labelFor="@+id/alert_duration"
                    android:text="@string/duration" />

                <EditText
                    android:id="@+id/alert_duration"
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="4" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/alert_end_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp">

                <TextView
                    style="@style/Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/alert_end_label" />

                <Button
                    android:id="@+id/alert_end"
                    style="@style/Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAllCaps="false" />
            </LinearLayout>

            <TextView
                style="@style/Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/alert_style_label" />

            <RadioGroup
                android:id="@+id/alert_style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/style_full"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/style_full" />

                <RadioButton
                    android:id="@+id/style_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/style_card" />

                <RadioButton
                    android:id="@+id/style_notification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/style_notification" />
            </RadioGroup>

            <TextView
                android:id="@+id/alert_style_text"
                style="@style/Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/alert_sound_label" />

            <Spinner
                android:id="@+id/alert_sound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/alert_sound_label"
                android:entries="@array/alert_sounds"
                android:minHeight="48dp" />

            <LinearLayout
                android:id="@+id/alert_volume_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp">

                <TextView
                    android:id="@+id/alert_volume_label"
                    style="@style/Body"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no" />

                <SeekBar
                    android:id="@+id/alert_volume"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/alert_volume_name"
                    android:max="100" />
            </LinearLayout>

            <Button
                android:id="@+id/alert_sound_pick"
                style="@style/Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false" />

            <LinearLayout
                android:id="@+id/alert_banner_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/alert_banner_pick"
                    style="@style/Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start|center_vertical"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/alert_banner_remove"
                    style="@style/Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/remove" />
            </LinearLayout>

            <TextView
                style="@style/Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/alert_snooze_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp">

                <TextView
                    style="@style/Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:labelFor="@+id/alert_snooze_limit"
                    android:text="@string/alert_snooze_limit" />

                <EditText
                    android:id="@+id/alert_snooze_limit"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:hint="@string/alert_unlimited"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/alert_show_dismiss"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/alert_show_dismiss" />

            <TextView
                style="@style/Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/alert_block_label" />

            <RadioGroup
                android:id="@+id/alert_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/block_none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/block_none" />

                <RadioButton
                    android:id="@+id/block_current"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/block_current" />

                <RadioButton
                    android:id="@+id/block_custom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/block_custom" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/alert_block_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/alert_current_note"
                    style="@style/Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/alert_current_note" />

                <LinearLayout
                    android:id="@+id/alert_custom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/alert_apps_label"
                        style="@style/Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <Button
                            android:id="@+id/alert_choose_apps"
                            style="@style/Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/choose_apps" />

                        <Button
                            android:id="@+id/alert_copy_apps"
                            style="@style/Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/alert_copy_apps" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/alert_sites"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/alert_sites_hint"
                        android:importantForAutofill="no"
                        android:inputType="textUri|textMultiLine" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="48dp">

                    <TextView
                        style="@style/Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:labelFor="@+id/alert_delay"
                        android:text="@string/alert_delay_label" />

                    <EditText
                        android:id="@+id/alert_delay"
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="3" />
                </LinearLayout>

                <TextView
                    style="@style/Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/alert_block_hint" />
            </LinearLayout>

            <Button
                android:id="@+id/alert_delete"
                style="@style/Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/alert_delete" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <Button
            android:id="@+id/alert_preview"
            style="@style/Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/alert_preview" />

        <Button
            android:id="@+id/alert_save"
            style="@style/Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/save" />
    </LinearLayout>
</LinearLayout>
