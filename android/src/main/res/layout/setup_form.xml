<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="24dp">

    <TextView
        style="@style/Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/setup_title" />

    <LinearLayout
        android:id="@+id/blocking_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/card"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/blocking_explain" />

        <Button
            android:id="@+id/enable_blocking"
            style="@style/Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/enable_blocking" />

        <TextView
            style="@style/Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/restricted_hint" />

        <Button
            android:id="@+id/app_info"
            style="@style/Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_info" />
    </LinearLayout>

    <EditText
        android:id="@+id/intention_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/intention_hint"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLength="120" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp">

        <TextView
            style="@style/Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:labelFor="@+id/duration"
            android:text="@string/duration" />

        <EditText
            android:id="@+id/duration"
            android:layout_width="96dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="4" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp">

        <CheckBox
            android:id="@+id/delay_enabled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/delay" />

        <EditText
            android:id="@+id/delay"
            android:layout_width="96dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:hint="@string/delay_label"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="3" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/strict"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/strict" />

    <TextView
        style="@style/Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/strict_hint" />

    <TextView
        style="@style/Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/apps_title" />

    <TextView
        android:id="@+id/apps_label"
        style="@style/Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <Button
        android:id="@+id/choose_apps"
        style="@style/Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/choose_apps" />

    <TextView
        style="@style/Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/sites_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/site_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/site_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLength="2048" />

        <Button
            android:id="@+id/add_site"
            style="@style/Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_site" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/site_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        style="@style/Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="@string/sites_note" />

    <Button
        android:id="@+id/open_limits"
        style="@style/Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/limits_open" />
</LinearLayout>
