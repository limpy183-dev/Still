<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/refused"
        style="@style/Body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include layout="@layout/setup_form" />
        </ScrollView>

        <Button
            android:id="@+id/start"
            style="@style/Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="@string/start" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/active"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/in_session" />

            <TextView
                android:id="@+id/intention"
                style="@style/Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Chronometer
                android:id="@+id/countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:countDown="true"
                android:textColor="@color/ink"
                android:textSize="56sp" />

            <TextView
                android:id="@+id/until"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/blocking"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/release"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp" />

            <Button
                android:id="@+id/request"
                style="@style/Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/end"
                style="@style/Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/end" />

            <Button
                android:id="@+id/open_limits_active"
                style="@style/Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/limits_open" />

            <Button
                android:id="@+id/open_alerts_active"
                style="@style/Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alerts_title" />

            <Button
                android:id="@+id/open_todos_active"
                style="@style/Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/todos_open" />

            <Button
                android:id="@+id/open_history_active"
                style="@style/Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/history_title" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
