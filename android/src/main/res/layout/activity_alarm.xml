<?xml version="1.0" encoding="utf-8"?>
<!-- The alarm (app/alarm.html): Full attention fills the screen; Focus card uses the same content in a floating card. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:text="@string/alarm_brand"
            android:textColor="@color/green" />

        <FrameLayout
            android:id="@+id/alarm_media"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/alarm_eyebrow"
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/alarm_orbit"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginVertical="24dp"
            android:background="@drawable/alarm_orbit"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="@string/alarm_orbit"
            android:textColor="@color/green"
            android:textSize="44sp" />

        <TextView
            android:id="@+id/alarm_title"
            style="@style/Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center" />

        <TextView
            android:id="@+id/alarm_note"
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/muted" />

        <TextView
            android:id="@+id/alarm_time"
            style="@style/Hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/alarm_pill"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:textColor="@color/green" />

        <TextView
            android:id="@+id/alarm_message"
            style="@style/Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center" />

        <TextView
            android:id="@+id/alarm_error"
            style="@style/Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="assertive"
            android:gravity="center"
            android:textColor="@color/warn" />

        <Button
            android:id="@+id/alarm_open"
            style="@style/Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/alarm_open" />

        <Button
            android:id="@+id/alarm_snooze"
            style="@style/Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/alarm_snooze" />

        <Button
            android:id="@+id/alarm_dismiss"
            style="@style/Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/alarm_dismiss" />

        <TextView
            android:id="@+id/alarm_footnote"
            style="@style/Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center" />
    </LinearLayout>
</ScrollView>
