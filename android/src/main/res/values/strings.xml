    <!-- Strict mode finds Still's own screens by this name, so keep it distinctive. -->
    <string name="app_name">Still Focus</string>
    <string name="service_description">Still uses this during a focus session to see which app is on screen, send the apps you chose to block back to the home screen, and read the address bar of supported browsers to step back from websites you chose to block. It stores nothing about what you do and does nothing when no session is running. During a strict session it also covers the Settings pages that could switch Still off.</string>

