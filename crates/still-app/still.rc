1 ICON "../../assets/still.ico"
1 24 "still.manifest"
1 VERSIONINFO
 FILEVERSION 2,0,2,0
 PRODUCTVERSION 2,0,2,0
 FILEOS 0x40004
 FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Still"
      VALUE "FileDescription", "Still"
      VALUE "FileVersion", "2.0.2"
      VALUE "InternalName", "Still"
      VALUE "OriginalFilename", "Still.exe"
      VALUE "ProductName", "Still"
      VALUE "ProductVersion", "2.0.2"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
