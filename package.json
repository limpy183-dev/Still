{
  "name": "still-focus",
  "version": "2.0.1",
  "description": "A quieter space for your attention. Windows app blocking and intentional focus.",
  "private": true,
  "scripts": {
    "start": "cargo run -p still-app",
    "demo": "cargo run -p still-app -- --demo",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "build:extension": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-store-extension.ps1",
    "test": "node --test tests/*.test.cjs",
    "test:rust": "cargo test --workspace --release",
    "test:policy": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/policy.ps1",
    "test:csp": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/csp-policy.ps1",
    "test:ui": "node tests/ui.cjs",
    "test:accessibility": "node tests/accessibility.cjs",
    "test:startup": "node tests/startup.cjs",
    "test:todos": "node tests/todos.cjs",
    "test:new": "node tests/new-things.cjs",
    "test:alerts": "node tests/alerts-ui.cjs",
    "test:alerts-wake": "node tests/alerts-wake.cjs",
    "test:websites": "node tests/websites-ui.cjs && node tests/website-browser.cjs && node tests/website-host.cjs",
    "test:installer": "node tests/installer.cjs",
    "test:portability": "node tests/portability.cjs"
  },
  "keywords": [],
  "author": "Still",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "playwright": "1.58.2"
  }
}
